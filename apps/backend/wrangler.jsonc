{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sardrobe-backend",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "http://localhost:4321",
    "SENTRY_DSN": ""
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "WARDROBE_MEDIA"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/data-ops/drizzle"
    }
  ]
}
