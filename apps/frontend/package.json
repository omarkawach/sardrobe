{
  "name": "@sardrobe/frontend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "dev:cf": "pnpm build && wrangler dev",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "test": "vitest run",
    "test:e2e:webmcp": "pnpm --filter @sardrobe/react-components build && APP_ENV=development PUBLIC_APP_URL=http://localhost:4344 PUBLIC_BACKGROUND_REMOVAL_MANIFEST_URL=/models/isnet-general-use-1024-webgpu-v2/manifest.json pnpm build && node e2e/webmcp.mjs",
    "typecheck": "astro check",
    "cf:check": "wrangler deploy --dry-run",
    "cf:check:sardrobe:development": "wrangler deploy --dry-run --config wrangler.sardrobe.jsonc --env development",
    "cf:check:sardrobe:production": "wrangler deploy --dry-run --config wrangler.sardrobe.jsonc --env production",
    "types": "wrangler types --env-file .env.types",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:sardrobe:development": "APP_ENV=development PUBLIC_APP_URL=https://dev.sardrobe.com pnpm build && wrangler deploy --config wrangler.sardrobe.jsonc --env development",
    "deploy:sardrobe:production": "APP_ENV=production PUBLIC_APP_URL=https://sardrobe.com pnpm build && wrangler deploy --config wrangler.sardrobe.jsonc --env production"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@browser-ai/transformers-js": "^3.0.5",
    "@huggingface/transformers": "4.2.0",
    "@sardrobe/background-remover": "workspace:*",
    "@sardrobe/react-components": "workspace:*",
    "@sentry/astro": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@use-gesture/react": "^10.3.1",
    "ai": "^7.0.179",
    "astro": "catalog:",
    "astro-seo": "^1.2.0",
    "better-auth": "^1.7.27",
    "lucide-react": "^1.77.0",
    "medium-zoom": "1.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@w3c/webmcp-polyfill": "0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/react": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "miniflare": "5.20261119.0-beta",
    "typescript": "catalog:",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "catalog:",
    "webmcp-types": "0.1.11",
    "wrangler": "4.166.0"
  }
}
