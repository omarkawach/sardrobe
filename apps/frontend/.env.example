APP_ENV=development
PUBLIC_APP_URL=http://localhost:4321

# `pnpm dev` serves the exported model from packages/background-remover/tooling/build.
# Production uses the private R2-backed /models route in .env.production.
PUBLIC_BACKGROUND_REMOVAL_MANIFEST_URL=http://localhost:8790/manifest.json

# Optional Sentry configuration. Leave blank to disable Sentry.
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
