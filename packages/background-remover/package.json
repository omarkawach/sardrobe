{
  "name": "@sardrobe/background-remover",
  "version": "0.0.0",
  "private": true,
  "description": "In-browser garment background removal for Sardrobe, powered by a DIS ISNet ONNX model running on ONNX Runtime Web (WebGPU with WASM fallback).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tooling/README.md",
    "tooling/pyproject.toml",
    "tooling/uv.lock",
    "tooling/export_isnet_onnx.py",
    "tooling/validate_onnx.py",
    "tooling/build_manifest.mjs",
    "tooling/serve_model.mjs",
    "tooling/dis/isnet.py",
    "NOTICE"
  ],
  "scripts": {
    "dev": "node tooling/serve_model.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "ndarray": "^1.1.1",
    "onnxruntime-web": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/ndarray": "^1.0.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
